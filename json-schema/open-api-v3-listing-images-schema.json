{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ListingImages",
  "description": "Represents a list of listing image resources, each of which contains the reference URLs and metadata for an image.",
  "$id": "https://raw.githubusercontent.com/api-evangelist/etsy/refs/heads/main/json-schema/open-api-v3-listing-images-schema.json",
  "type": "object",
  "properties": {
    "count": {
      "type": "integer",
      "description": "The number of results.",
      "minimum": 0,
      "example": 1
    },
    "results": {
      "type": "array",
      "description": "The list of requested resources.",
      "items": {
        "description": "The list of requested resources.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ListingImage"
          }
        ]
      }
    }
  }
}