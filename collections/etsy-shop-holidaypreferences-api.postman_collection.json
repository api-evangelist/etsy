                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<integer>",
                  "key": "holiday_id",
                  "description": "(Required) The unique id that maps to the holiday a country observes. See the [Fulfillment Tutorial docs](https://developer.etsy.com/documentation/tutorials/fulfillment/#country-holidays) for more info"
