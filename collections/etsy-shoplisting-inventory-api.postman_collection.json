          "id": "ff282bd6-afc6-4d63-a607-82182ce3b297",
          "name": "Etsy Get Listing Inventory",
          "request": {
            "name": "Etsy Get Listing Inventory",
            "description": {
              "content": "<div class=\"wt-display-flex-xs wt-align-items-center wt-mt-xs-2 wt-mb-xs-3\"><span class=\"wt-badge wt-badge--notificationPrimary wt-bg-slime-tint wt-mr-xs-2\">General Release</span><a class=\"wt-text-link\" href=\"https://github.com/etsy/open-api/discussions\" target=\"_blank\" rel=\"noopener noreferrer\">Report bug</a></div><div class=\"wt-display-flex-xs wt-align-items-center wt-mt-xs-2 wt-mb-xs-3\"><p class=\"wt-text-body-01 banner-text\">This endpoint is ready for production use.</p></div>\n\nRetrieves the inventory record for a listing. Listings you did not edit using the Etsy.com inventory tools have no inventory records. This endpoint returns SKU data if you are the owner of the inventory records being fetched.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "application",
                "listings",
                ":listing_id",
                "inventory"
              ],
