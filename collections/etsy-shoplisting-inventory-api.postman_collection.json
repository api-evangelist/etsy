                  "type": "any",
                  "value": "<long>",
                  "key": "listing_id",
                  "description": "(Required) The numeric ID for the [listing](/documentation/reference#tag/ShopListing) associated to this transaction."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
